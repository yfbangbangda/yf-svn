{
  "name": "yf-svn",
  "displayName": "YF SVN",
  "description": "面向 Windows 10/11 的 VS Code Subversion 集成。",
  "version": "1.3.4",
  "publisher": "yf",
  "license": "MIT",
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "svn",
    "subversion",
    "scm"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.svn/wc.db",
    "workspaceContains:**/.svn/wc.db"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test dist/test/**/*.test.js",
    "test:host": "npm run compile && node dist/test/runHost.js",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.2"
  },
  "contributes": {
    "submenus": [
      {
        "id": "yfSvn.editorContext",
        "label": "SVN"
      },
      {
        "id": "yfSvn.explorerContext",
        "label": "SVN"
      }
    ],
    "colors": [
      {
        "id": "yfSvnDecoration.modifiedResourceForeground",
        "description": "SVN 已修改资源的前景色。",
        "defaults": {
          "light": "#0066B8",
          "dark": "#3794FF",
          "highContrast": "#3794FF",
          "highContrastLight": "#0066B8"
        }
      },
      {
        "id": "yfSvnDecoration.addedResourceForeground",
        "description": "SVN 已添加资源的前景色。",
        "defaults": {
          "light": "#587C0C",
          "dark": "#81B88B",
          "highContrast": "#A1E3AD",
          "highContrastLight": "#374E06"
        }
      },
      {
        "id": "yfSvnDecoration.untrackedResourceForeground",
        "description": "SVN 未版本控制资源的前景色。",
        "defaults": {
          "light": "#895503",
          "dark": "#E2C08D",
          "highContrast": "#E2C08D",
          "highContrastLight": "#895503"
        }
      },
      {
        "id": "yfSvnDecoration.deletedResourceForeground",
        "description": "SVN 已删除或缺失资源的前景色。",
        "defaults": {
          "light": "#AD0707",
          "dark": "#C74E39",
          "highContrast": "#C74E39",
          "highContrastLight": "#AD0707"
        }
      },
      {
        "id": "yfSvnDecoration.renamedResourceForeground",
        "description": "SVN 已替换资源的前景色。",
        "defaults": {
          "light": "#007100",
          "dark": "#73C991",
          "highContrast": "#73C991",
          "highContrastLight": "#007100"
        }
      },
      {
        "id": "yfSvnDecoration.ignoredResourceForeground",
        "description": "SVN 已忽略资源的前景色。",
        "defaults": {
          "light": "#8E8E90",
          "dark": "#8C8C8C",
          "highContrast": "#A7A8A9",
          "highContrastLight": "#8E8E90"
        }
      },
      {
        "id": "yfSvnDecoration.conflictingResourceForeground",
        "description": "SVN 冲突资源的前景色。",
        "defaults": {
          "light": "#AD0707",
          "dark": "#E4676B",
          "highContrast": "#C74E39",
          "highContrastLight": "#AD0707"
        }
      },
      {
        "id": "yfSvnDecoration.externalResourceForeground",
        "description": "SVN External 资源的前景色。",
        "defaults": {
          "light": "#1258A7",
          "dark": "#8DB9E2",
          "highContrast": "#8DB9E2",
          "highContrastLight": "#1258A7"
        }
      }
    ],
    "commands": [
      {
        "command": "yfSvn.refresh",
        "title": "SVN: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "yfSvn.commit",
        "title": "SVN: 提交",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "yfSvn.commitAll",
        "title": "SVN: 全部提交",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "yfSvn.update",
        "title": "SVN: 更新",
        "icon": "$(cloud-download)"
      },
      {
        "command": "yfSvn.branchTag",
        "title": "SVN: 创建分支/标签"
      },
      {
        "command": "yfSvn.switch",
        "title": "SVN: 切换分支/标签"
      },
      {
        "command": "yfSvn.merge",
        "title": "SVN: 合并"
      },
      {
        "command": "yfSvn.mergeinfo",
        "title": "SVN: 查看合并信息"
      },
      {
        "command": "yfSvn.updateFile",
        "title": "SVN: 更新文件"
      },
      {
        "command": "yfSvn.updateDirectory",
        "title": "SVN: 更新目录"
      },
      {
        "command": "yfSvn.checkout",
        "title": "SVN: 检出"
      },
      {
        "command": "yfSvn.add",
        "title": "SVN: 添加",
        "icon": "$(add)"
      },
      {
        "command": "yfSvn.delete",
        "title": "SVN: 删除"
      },
      {
        "command": "yfSvn.revert",
        "title": "SVN: 还原"
      },
      {
        "command": "yfSvn.rename",
        "title": "SVN: 移动/重命名"
      },
      {
        "command": "yfSvn.ignore",
        "title": "SVN: 忽略"
      },
      {
        "command": "yfSvn.lock",
        "title": "SVN: 锁定",
        "icon": "$(lock)"
      },
      {
        "command": "yfSvn.unlock",
        "title": "SVN: 解锁",
        "icon": "$(unlock)"
      },
      {
        "command": "yfSvn.property",
        "title": "SVN: 管理属性",
        "icon": "$(settings-gear)"
      },
      {
        "command": "yfSvn.changelist",
        "title": "SVN: 管理 Changelist"
      },
      {
        "command": "yfSvn.cleanup",
        "title": "SVN: 清理工作副本"
      },
      {
        "command": "yfSvn.compare",
        "title": "SVN: 比较版本",
        "icon": "$(diff)"
      },
      {
        "command": "yfSvn.openConflict",
        "title": "SVN: 打开冲突处理",
        "icon": "$(merge)"
      },
      {
        "command": "yfSvn.resolve",
        "title": "SVN: 标记冲突已解决",
        "icon": "$(pass)"
      },
      {
        "command": "yfSvn.log",
        "title": "SVN: 查看历史",
        "icon": "$(history)"
      },
      {
        "command": "yfSvn.blame",
        "title": "SVN: 显示/隐藏逐行追溯",
        "icon": "$(git-commit)"
      },
      {
        "command": "yfSvn.diagnose",
        "title": "SVN: 诊断"
      },
      {
        "command": "yfSvn.showOutput",
        "title": "SVN: 显示输出"
      },
      {
        "command": "yfSvn.forceLock",
        "title": "SVN: 强制锁定"
      },
      {
        "command": "yfSvn.forceUnlock",
        "title": "SVN: 强制解锁"
      },
      {
        "command": "yfSvn.updateAdvanced",
        "title": "SVN: 高级更新"
      },
      {
        "command": "yfSvn.continueMerge",
        "title": "SVN: 执行本次合并",
        "icon": "$(merge)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "yfSvn.refresh",
          "when": "scmProvider == yfSvn",
          "group": "navigation@1"
        },
        {
          "command": "yfSvn.update",
          "when": "scmProvider == yfSvn",
          "group": "navigation@2"
        },
        {
          "command": "yfSvn.commitAll",
          "when": "scmProvider == yfSvn",
          "group": "navigation@3"
        },
        {
          "command": "yfSvn.branchTag",
          "when": "scmProvider == yfSvn",
          "group": "2_svn@1"
        },
        {
          "command": "yfSvn.switch",
          "when": "scmProvider == yfSvn",
          "group": "2_svn@2"
        },
        {
          "command": "yfSvn.merge",
          "when": "scmProvider == yfSvn",
          "group": "2_svn@2.1"
        },
        {
          "command": "yfSvn.mergeinfo",
          "when": "scmProvider == yfSvn",
          "group": "2_svn@2.2"
        },
        {
          "command": "yfSvn.cleanup",
          "when": "scmProvider == yfSvn",
          "group": "2_svn@3"
        },
        {
          "command": "yfSvn.log",
          "when": "scmProvider == yfSvn",
          "group": "2_svn@4"
        },
        {
          "command": "yfSvn.updateAdvanced",
          "when": "scmProvider == yfSvn",
          "group": "2_svn@0"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "yfSvn.commit",
          "when": "scmProvider == yfSvn && scmResourceGroup =~ /^changelist:/",
          "group": "inline@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "yfSvn.commit",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bcommittable\\b/",
          "group": "2_changes@2"
        },
        {
          "command": "yfSvn.compare",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bdiffable\\b/",
          "group": "inline@1"
        },
        {
          "command": "yfSvn.openConflict",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bconflicted\\b/",
          "group": "inline@1"
        },
        {
          "command": "yfSvn.add",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\baddable\\b/",
          "group": "inline@2"
        },
        {
          "command": "yfSvn.resolve",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bconflicted\\b/",
          "group": "inline@2"
        },
        {
          "command": "yfSvn.revert",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\brevertible\\b/",
          "group": "2_changes@4"
        },
        {
          "command": "yfSvn.delete",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bdeletable\\b/",
          "group": "2_changes@5"
        },
        {
          "command": "yfSvn.rename",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\brenamable\\b/",
          "group": "2_changes@6"
        },
        {
          "command": "yfSvn.ignore",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bignorable\\b/",
          "group": "2_changes@7"
        },
        {
          "command": "yfSvn.changelist",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bchangelistable\\b/",
          "group": "5_management@4"
        },
        {
          "command": "yfSvn.lock",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\blockable\\b/",
          "group": "5_management@1"
        },
        {
          "command": "yfSvn.unlock",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bunlockable\\b/",
          "group": "5_management@2"
        },
        {
          "command": "yfSvn.property",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bmutableVersioned\\b/",
          "group": "5_management@3"
        },
        {
          "command": "yfSvn.log",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bhistorical\\b/",
          "group": "4_history@1"
        },
        {
          "command": "yfSvn.blame",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\bblamable\\b/",
          "group": "4_history@2"
        },
        {
          "command": "yfSvn.forceLock",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\b(lockable|unlockable)\\b/",
          "group": "6_force@1"
        },
        {
          "command": "yfSvn.forceUnlock",
          "when": "scmProvider == yfSvn && scmResourceState =~ /\\b(lockable|unlockable)\\b/",
          "group": "6_force@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "yfSvn.explorerContext",
          "when": "resourceScheme == file && resource in yfSvn.knownResources",
          "group": "svn@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "yfSvn.editorContext",
          "when": "resourceScheme == file && resource in yfSvn.knownResources",
          "group": "9_cutcopypaste@100"
        }
      ],
      "yfSvn.editorContext": [
        {
          "command": "yfSvn.updateFile",
          "when": "resource in yfSvn.updatableResources",
          "group": "1_update@1"
        },
        {
          "command": "yfSvn.add",
          "when": "resource in yfSvn.addableResources",
          "group": "2_changes@1"
        },
        {
          "command": "yfSvn.commit",
          "when": "resource in yfSvn.committableResources",
          "group": "2_changes@2"
        },
        {
          "command": "yfSvn.revert",
          "when": "resource in yfSvn.revertibleResources",
          "group": "2_changes@4"
        },
        {
          "command": "yfSvn.ignore",
          "when": "resource in yfSvn.ignorableResources",
          "group": "2_changes@7"
        },
        {
          "command": "yfSvn.compare",
          "when": "resource in yfSvn.diffableResources",
          "group": "2_changes@3"
        },
        {
          "command": "yfSvn.log",
          "when": "resource in yfSvn.historicalResources",
          "group": "4_history@1"
        },
        {
          "command": "yfSvn.blame",
          "when": "resource in yfSvn.blamableResources",
          "group": "4_history@2"
        },
        {
          "command": "yfSvn.lock",
          "when": "resource in yfSvn.lockableResources",
          "group": "5_management@1"
        },
        {
          "command": "yfSvn.unlock",
          "when": "resource in yfSvn.unlockableResources",
          "group": "5_management@2"
        },
        {
          "command": "yfSvn.property",
          "when": "resource in yfSvn.mutableVersionedResources",
          "group": "5_management@3"
        },
        {
          "command": "yfSvn.changelist",
          "when": "resource in yfSvn.changelistableResources",
          "group": "5_management@4"
        },
        {
          "command": "yfSvn.forceLock",
          "when": "resource in yfSvn.lockableResources || resource in yfSvn.unlockableResources",
          "group": "6_force@1"
        },
        {
          "command": "yfSvn.forceUnlock",
          "when": "resource in yfSvn.lockableResources || resource in yfSvn.unlockableResources",
          "group": "6_force@2"
        },
        {
          "command": "yfSvn.delete",
          "when": "resource in yfSvn.deletableResources",
          "group": "2_changes@5"
        },
        {
          "command": "yfSvn.rename",
          "when": "resource in yfSvn.renamableResources",
          "group": "2_changes@6"
        },
        {
          "command": "yfSvn.openConflict",
          "when": "resource in yfSvn.conflictedResources",
          "group": "3_conflicts@1"
        },
        {
          "command": "yfSvn.resolve",
          "when": "resource in yfSvn.conflictedResources",
          "group": "3_conflicts@2"
        },
        {
          "command": "yfSvn.updateAdvanced",
          "when": "resource in yfSvn.updatableResources",
          "group": "1_update@2"
        }
      ],
      "editor/title": [
        {
          "command": "yfSvn.continueMerge",
          "when": "resourceScheme == yf-svn-merge-preview",
          "group": "navigation@1"
        }
      ],
      "yfSvn.explorerContext": [
        {
          "command": "yfSvn.updateFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resource in yfSvn.updatableResources",
          "group": "1_update@1"
        },
        {
          "command": "yfSvn.updateDirectory",
          "when": "resourceScheme == file && explorerResourceIsFolder && resource in yfSvn.updatableResources",
          "group": "1_update@1"
        },
        {
          "command": "yfSvn.add",
          "when": "resourceScheme == file && resource in yfSvn.addableResources",
          "group": "2_changes@1"
        },
        {
          "command": "yfSvn.commit",
          "when": "resourceScheme == file && resource in yfSvn.committableResources",
          "group": "2_changes@2"
        },
        {
          "command": "yfSvn.revert",
          "when": "resourceScheme == file && resource in yfSvn.revertibleResources",
          "group": "2_changes@4"
        },
        {
          "command": "yfSvn.ignore",
          "when": "resourceScheme == file && resource in yfSvn.ignorableResources",
          "group": "2_changes@7"
        },
        {
          "command": "yfSvn.compare",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resource in yfSvn.diffableResources",
          "group": "2_changes@3"
        },
        {
          "command": "yfSvn.log",
          "when": "resourceScheme == file && resource in yfSvn.historicalResources",
          "group": "4_history@1"
        },
        {
          "command": "yfSvn.blame",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resource in yfSvn.blamableResources",
          "group": "4_history@2"
        },
        {
          "command": "yfSvn.lock",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resource in yfSvn.lockableResources",
          "group": "5_management@1"
        },
        {
          "command": "yfSvn.unlock",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resource in yfSvn.unlockableResources",
          "group": "5_management@2"
        },
        {
          "command": "yfSvn.property",
          "when": "resourceScheme == file && resource in yfSvn.mutableVersionedResources",
          "group": "5_management@3"
        },
        {
          "command": "yfSvn.changelist",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resource in yfSvn.changelistableResources",
          "group": "5_management@4"
        },
        {
          "command": "yfSvn.forceLock",
          "when": "resourceScheme == file && !explorerResourceIsFolder && (resource in yfSvn.lockableResources || resource in yfSvn.unlockableResources)",
          "group": "6_force@1"
        },
        {
          "command": "yfSvn.forceUnlock",
          "when": "resourceScheme == file && !explorerResourceIsFolder && (resource in yfSvn.lockableResources || resource in yfSvn.unlockableResources)",
          "group": "6_force@2"
        },
        {
          "command": "yfSvn.delete",
          "when": "resourceScheme == file && resource in yfSvn.deletableResources",
          "group": "2_changes@5"
        },
        {
          "command": "yfSvn.rename",
          "when": "resourceScheme == file && resource in yfSvn.renamableResources",
          "group": "2_changes@6"
        },
        {
          "command": "yfSvn.openConflict",
          "when": "resourceScheme == file && resource in yfSvn.conflictedResources",
          "group": "3_conflicts@1"
        },
        {
          "command": "yfSvn.resolve",
          "when": "resourceScheme == file && resource in yfSvn.conflictedResources",
          "group": "3_conflicts@2"
        },
        {
          "command": "yfSvn.updateAdvanced",
          "when": "resourceScheme == file && resource in yfSvn.updatableResources",
          "group": "1_update@2"
        }
      ]
    },
    "configuration": {
      "title": "YF SVN",
      "properties": {
        "yfSvn.path": {
          "type": "string",
          "default": "svn",
          "description": "svn.exe 的完整路径或可执行文件名。"
        },
        "yfSvn.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "保存文件和重新聚焦窗口后自动刷新 SVN 状态。"
        },
        "yfSvn.statusDepth": {
          "type": "string",
          "enum": [
            "empty",
            "files",
            "immediates",
            "infinity"
          ],
          "default": "infinity",
          "description": "扫描工作副本状态时使用的深度。"
        },
        "yfSvn.ignoreExternals": {
          "type": "boolean",
          "default": false,
          "description": "更新和检出时忽略 externals。"
        },
        "yfSvn.logLimit": {
          "type": "integer",
          "default": 50,
          "minimum": 10,
          "maximum": 500,
          "description": "每次加载的历史记录数量。"
        },
        "yfSvn.timeout": {
          "type": "integer",
          "default": 120000,
          "minimum": 5000,
          "maximum": 1800000,
          "description": "SVN 命令超时时间，单位为毫秒。"
        },
        "yfSvn.blameStyle": {
          "type": "string",
          "enum": [
            "compact",
            "full"
          ],
          "enumDescriptions": [
            "紧凑显示 revision 和作者，左侧固定占宽 24 个字符单位。",
            "显示 revision、作者和日期，左侧固定占宽 46 个字符单位。"
          ],
          "default": "compact",
          "description": "逐行追溯的显示方式。长内容以省略号收起，悬停可查看完整信息；修改后立即作用于已显示的追溯。",
          "scope": "resource"
        }
      }
    }
  }
}
